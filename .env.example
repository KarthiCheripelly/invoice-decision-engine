# Copy this file to .env and fill in ONE key. The app picks Claude if ANTHROPIC_API_KEY is set,
# otherwise Gemini if GEMINI_API_KEY is set, otherwise the local parser (clean PDFs only, no scans).

# Google Gemini - free tier, get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-latest

# Anthropic (paid)
# ANTHROPIC_API_KEY=sk-ant-...
# INVOICE_MODEL=claude-opus-5-5
